{% extends 'base.html.twig' %}

{% block title %}Creer une sous-categorie{% endblock %}

{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h1 class="h4 mb-0">Nouvelle sous-categorie</h1>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-bg-light">Gestion</span>
                            <a href="{{ path('app_sub_category_index') }}" class="btn btn-sm btn-outline-secondary">Retour</a>
                        </div>
                    </div>

                    <p class="text-muted mb-4">
                        Ajoutez une sous-categorie pour organiser vos produits.
                    </p>

                    {{ include('sub_category/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
