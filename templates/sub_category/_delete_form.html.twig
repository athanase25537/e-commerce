<form method="post"
      action="{{ path('app_sub_category_delete', {'id': sub_category.id}) }}"
      class="d-inline"
      onsubmit="return confirm('Supprimer cette sous-categorie ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sub_category.id) }}">
    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
</form>
