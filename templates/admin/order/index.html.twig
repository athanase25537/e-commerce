{% extends 'base.html.twig' %}

{% block title %}Admin | Commandes{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Commandes</h1>
            <p class="text-muted mb-0">{{ orders|length }} commande(s)</p>
        </div>
        <a href="{{ path('app_admin_order_index') }}" class="btn btn-outline-dark">Rafraichir</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Total</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            <tr>
                                <td>#{{ order.id }}</td>
                                <td>{{ order.customerName }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <span class="badge status-badge status-{{ order.status }}">{{ order.status }}</span>
                                </td>
                                <td>{{ order.totalAmount }}</td>
                                <td class="text-end">
                                    <a href="{{ path('app_admin_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-dark">Voir</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">Aucune commande.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
