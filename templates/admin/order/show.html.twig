{% extends 'base.html.twig' %}

{% block title %}Admin | Commande #{{ order.id }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Commande #{{ order.id }}</h1>
            <p class="text-muted mb-0">Client: {{ order.customerName }}</p>
        </div>
        <a href="{{ path('app_admin_order_index') }}" class="btn btn-outline-dark">Retour</a>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Articles</h2>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Prix</th>
                                    <th>Quantite</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in order.items %}
                                    <tr>
                                        <td>{{ item.productName }}</td>
                                        <td>{{ item.unitPrice }}</td>
                                        <td>{{ item.quantity }}</td>
                                        <td>{{ item.lineTotal }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-3">
                        <span>Total</span>
                        <strong>{{ order.totalAmount }}</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Informations client</h2>
                    <div class="text-muted small">
                        <div class="fw-semibold text-dark">{{ order.customerName }}</div>
                        <div>{{ order.addressLine1 }}</div>
                        {% if order.addressLine2 %}
                            <div>{{ order.addressLine2 }}</div>
                        {% endif %}
                        <div>{{ order.city }}{% if order.postalCode %}, {{ order.postalCode }}{% endif %}</div>
                        <div>{{ order.country }}</div>
                        <div class="mt-2">Email: {{ order.email }}</div>
                        {% if order.phone %}
                            <div>Telephone: {{ order.phone }}</div>
                        {% endif %}
                    </div>
                    <div class="mt-4">
                        <h3 class="h6">Statut</h3>
                        <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}" class="d-flex gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('order_status_' ~ order.id) }}">
                            <select name="status" class="form-select">
                                {% for status in statuses %}
                                    <option value="{{ status }}" {{ status == order.status ? 'selected' : '' }}>
                                        {{ status }}
                                    </option>
                                {% endfor %}
                            </select>
                            <button class="btn btn-dark">Mettre a jour</button>
                        </form>
                    </div>
                    <div class="mt-3">
                        <span class="badge status-badge status-{{ order.status }}">{{ order.status }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
