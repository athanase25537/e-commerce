{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0">Utilisateurs</h1>
        <span class="text-muted small">{{ users|length }} utilisateur(s)</span>
    </div>

    {% if users is empty %}
        <div class="alert alert-info mb-0">Aucun utilisateur pour le moment.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-muted">#</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Email</th>
                        <th scope="col">Roles</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="text-muted">{{ user.id }}</td>
                            <td>
                                <div class="fw-semibold">{{ user.firstname }} {{ user.lastname }}</div>
                            </td>
                            <td>{{ user.email }}</td>
                            <td class="text-muted small">{{ user.roles|join(', ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
