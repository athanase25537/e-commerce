{% extends 'base.html.twig' %}

{% block title %}Modifier code promo{% endblock %}

{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h1 class="h4 mb-0">Modifier le code promo</h1>
                        <a href="{{ path('app_coupon_index') }}" class="btn btn-sm btn-outline-secondary">Retour</a>
                    </div>

                    {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                        <div class="col-12 col-md-6">
                            {{ form_row(form.code) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_row(form.type) }}
                        </div>
                        <div class="col-12 col-md-4">
                            {{ form_row(form.value) }}
                        </div>
                        <div class="col-12 col-md-4">
                            {{ form_row(form.usageLimit) }}
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-end">
                            {{ form_row(form.active) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_row(form.startsAt) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_row(form.endsAt) }}
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-dark px-4">Mettre a jour</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
