{% extends 'base.html.twig' %}

{% block title %}Codes promo{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Codes promo</h1>
            <span class="text-muted small">{{ coupons|length }} code(s)</span>
        </div>
        <a href="{{ path('app_coupon_new') }}" class="btn btn-dark">Nouveau code</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Valeur</th>
                            <th>Utilisations</th>
                            <th>Actif</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for coupon in coupons %}
                            <tr>
                                <td class="fw-semibold">{{ coupon.code }}</td>
                                <td>{{ coupon.type }}</td>
                                <td>{{ coupon.value }}</td>
                                <td>{{ coupon.usedCount }}{% if coupon.usageLimit %}/{{ coupon.usageLimit }}{% endif %}</td>
                                <td>
                                    {% if coupon.active %}
                                        <span class="badge text-bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">Inactif</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_coupon_edit', {id: coupon.id}) }}" class="btn btn-sm btn-outline-dark">Editer</a>
                                    {{ include('coupon/_delete_form.html.twig', {coupon: coupon}) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted">Aucun code promo.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
