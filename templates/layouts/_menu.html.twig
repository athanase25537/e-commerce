{% set currentRoute = app.request.attributes.get('_route') ?? '' %}
{% set isUserRoute = currentRoute starts with 'app_user' %}
{% set isUserNewRoute = currentRoute == 'app_user_new' %}
{% set isCategoryRoute = currentRoute starts with 'app_category' %}
{% set isCategoryNewRoute = currentRoute == 'app_category_new' %}
{% set isSubCategoryRoute = currentRoute starts with 'app_sub_category' %}
{% set isSubCategoryNewRoute = currentRoute == 'app_sub_category_new' %}
{% set isProductRoute = currentRoute starts with 'app_product' %}
{% set isProductNewRoute = currentRoute == 'app_product_new' %}
{% set isHomeRoute = currentRoute == 'app_home' %}
{% set isLoginRoute = currentRoute == 'app_login' %}
{% set isRegisterRoute = currentRoute == 'app_register' %}
{% set isShopRoute = currentRoute starts with 'app_shop' %}
{% set isCartRoute = currentRoute starts with 'app_cart' %}
{% set isOrderRoute = currentRoute starts with 'app_order' %}
{% set isAdminOrderRoute = currentRoute starts with 'app_admin_order' %}
{% set isCouponRoute = currentRoute starts with 'app_coupon' %}
{% set cart = app.session ? app.session.get('cart', {}) : {} %}
{% set cartCount = 0 %}
{% for qty in cart %}
    {% set cartCount = cartCount + qty %}
{% endfor %}

<nav class="navbar navbar-expand-lg bg-body-tertiary app-navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_home') }}">E-commerce</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ isHomeRoute ? 'active' : '' }}"
                       {{ isHomeRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_home') }}">
                        Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isShopRoute ? 'active' : '' }}"
                       {{ isShopRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_shop_index') }}">
                        Boutique
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isCartRoute ? 'active' : '' }}"
                       {{ isCartRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_cart_index') }}">
                        Panier
                        {% if cartCount > 0 %}
                            <span class="badge rounded-pill bg-dark ms-1">{{ cartCount }}</span>
                        {% endif %}
                    </a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link {{ isOrderRoute ? 'active' : '' }}"
                           {{ isOrderRoute ? 'aria-current="page"' : '' }}
                           href="{{ path('app_order_index') }}">
                            Commandes
                        </a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle {{ isUserRoute or isUserNewRoute or isCategoryRoute or isCategoryNewRoute or isSubCategoryRoute or isSubCategoryNewRoute or isProductRoute or isProductNewRoute or isAdminOrderRoute or isCouponRoute ? 'active' : '' }}"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Commandes</h6></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_admin_order_index') }}">Toutes les commandes</a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h6 class="dropdown-header">Catalogue</h6></li>
                            <li><a class="dropdown-item" href="{{ path('app_product_index') }}">Produits</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_product_new') }}">Nouveau produit</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_category') }}">Categories</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_category_new') }}">Nouvelle categorie</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_sub_category_index') }}">Sous-categories</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_sub_category_new') }}">Nouvelle sous-categorie</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_coupon_index') }}">Codes promo</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_coupon_new') }}">Nouveau code</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h6 class="dropdown-header">Utilisateurs</h6></li>
                            <li><a class="dropdown-item" href="{{ path('app_user') }}">Liste utilisateurs</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_user_new') }}">Nouvel utilisateur</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                {% if app.user %}
                    <li class="nav-item">
                        <span class="nav-link navbar-text me-2">{{ app.user.userIdentifier }}</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">Deconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link {{ isLoginRoute ? 'active' : '' }}"
                           {{ isLoginRoute ? 'aria-current="page"' : '' }}
                           href="{{ path('app_login') }}">
                            Connexion
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ isRegisterRoute ? 'active' : '' }}"
                           {{ isRegisterRoute ? 'aria-current="page"' : '' }}
                           href="{{ path('app_register') }}">
                            Inscription
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
