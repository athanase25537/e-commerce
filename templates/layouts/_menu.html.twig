{% set currentRoute = app.request.attributes.get('_route') ?? '' %}
{% set isUserRoute = currentRoute starts with 'app_user' %}
{% set isUserNewRoute = currentRoute == 'app_user_new' %}
{% set isCategoryRoute = currentRoute starts with 'app_category' %}
{% set isCategoryNewRoute = currentRoute == 'app_category_new' %}
{% set isSubCategoryRoute = currentRoute starts with 'app_sub_category' %}
{% set isSubCategoryNewRoute = currentRoute == 'app_sub_category_new' %}
{% set isHomeRoute = currentRoute == 'app_home' %}
{% set isLoginRoute = currentRoute == 'app_login' %}
{% set isRegisterRoute = currentRoute == 'app_register' %}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">E-commerce</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ isHomeRoute ? 'active' : '' }}"
                       {{ isHomeRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_home') }}">
                        Accueil
                    </a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link {{ isUserRoute ? 'active' : '' }}"
                       {{ isUserRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_user') }}">
                        Utilisateurs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isUserNewRoute ? 'active' : '' }}"
                       {{ isUserNewRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_user_new') }}">
                        Nouvel utilisateur
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isCategoryRoute ? 'active' : '' }}"
                       {{ isCategoryRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_category') }}">
                        Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isCategoryNewRoute ? 'active' : '' }}"
                       {{ isCategoryNewRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_category_new') }}">
                        Nouvelle categorie
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isSubCategoryRoute ? 'active' : '' }}"
                       {{ isSubCategoryRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_sub_category_index') }}">
                        Sous-categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ isSubCategoryNewRoute ? 'active' : '' }}"
                       {{ isSubCategoryNewRoute ? 'aria-current="page"' : '' }}
                       href="{{ path('app_sub_category_new') }}">
                        Nouvelle sous-categorie
                    </a>
                </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                {% if app.user %}
                    <li class="nav-item">
                        <span class="navbar-text me-2">{{ app.user.userIdentifier }}</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">Deconnexion</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link {{ isLoginRoute ? 'active' : '' }}"
                           {{ isLoginRoute ? 'aria-current="page"' : '' }}
                           href="{{ path('app_login') }}">
                            Connexion
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ isRegisterRoute ? 'active' : '' }}"
                           {{ isRegisterRoute ? 'aria-current="page"' : '' }}
                           href="{{ path('app_register') }}">
                            Inscription
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
