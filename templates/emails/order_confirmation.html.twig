<h2>Merci pour votre commande #{{ order.id }}</h2>
<p>Bonjour {{ order.customerName }},</p>
<p>Votre commande a bien ete enregistree.</p>

<h3>Resume</h3>
<ul>
    {% for item in order.items %}
        <li>{{ item.productName }} (x{{ item.quantity }}) - {{ item.lineTotal }}</li>
    {% endfor %}
</ul>

<p>Sous-total: {{ order.subtotal }}</p>
{% if order.discountAmount > 0 %}
    <p>Remise: -{{ order.discountAmount }}</p>
{% endif %}
<p>Livraison: {{ order.shippingFee }}</p>
<p><strong>Total: {{ order.totalAmount }}</strong></p>

<h3>Livraison</h3>
<p>
    {{ order.customerName }}<br>
    {{ order.addressLine1 }}<br>
    {% if order.addressLine2 %}{{ order.addressLine2 }}<br>{% endif %}
    {{ order.city }}{% if order.postalCode %}, {{ order.postalCode }}{% endif %}<br>
    {{ order.country }}
</p>
