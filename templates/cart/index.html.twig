{% extends 'base.html.twig' %}

{% block title %}Panier | E-commerce{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Votre panier</h1>
            <p class="text-muted mb-0">{{ items|length }} article(s)</p>
        </div>
        <a href="{{ path('app_shop_index') }}" class="btn btn-outline-dark">Continuer les achats</a>
    </div>

    {% if items is empty %}
        <div class="alert alert-light">Votre panier est vide.</div>
    {% else %}
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Produit</th>
                                        <th>Prix</th>
                                        <th>Quantite</th>
                                        <th>Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="cart-thumb">
                                                        {% if item.product.imageSrc %}
                                                            <img src="{{ item.product.imageSrc }}" alt="{{ item.product.name }}">
                                                        {% else %}
                                                            <div class="product-card__placeholder">Image</div>
                                                        {% endif %}
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">{{ item.product.name }}</div>
                                                        <div class="text-muted small">{{ item.product.description|slice(0, 60) }}{% if item.product.description|length > 60 %}...{% endif %}</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>{{ item.product.price }}</td>
                                            <td>
                                                <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}" class="d-flex align-items-center gap-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.product.id) }}">
                                                    <input type="number"
                                                           name="quantity"
                                                           class="form-control form-control-sm"
                                                           value="{{ item.quantity }}"
                                                           min="0"
                                                           {% if item.product.stock is not null %}max="{{ item.product.stock }}"{% endif %}>
                                                    <button class="btn btn-outline-dark btn-sm">Maj</button>
                                                </form>
                                            </td>
                                            <td>{{ item.lineTotal }}</td>
                                            <td class="text-end">
                                                <form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.product.id) }}">
                                                    <button class="btn btn-link text-danger">Supprimer</button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">Resume</h2>
                        <div class="d-flex justify-content-between py-2">
                            <span>Sous-total</span>
                            <strong>{{ total }}</strong>
                        </div>
                        {% if discount > 0 %}
                            <div class="d-flex justify-content-between py-2">
                                <span>Remise{% if coupon %} ({{ coupon.code }}){% endif %}</span>
                                <strong>-{{ discount }}</strong>
                            </div>
                        {% endif %}
                        <div class="d-flex justify-content-between border-top pt-3 mt-2">
                            <span>Total a payer</span>
                            <strong>{{ total - discount }}</strong>
                        </div>
                        <div class="d-grid gap-2 mt-3">
                            {% if app.user %}
                                <a href="{{ path('app_checkout') }}" class="btn btn-dark btn-lg">Passer la commande</a>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn btn-dark btn-lg">Se connecter</a>
                                <a href="{{ path('app_register') }}" class="btn btn-outline-dark">Creer un compte</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body">
                        <h3 class="h6">Code promo</h3>
                        <form method="post" action="{{ path('app_cart_coupon') }}" class="d-flex flex-wrap gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_coupon') }}">
                            <input type="text" name="code" class="form-control form-control-sm" placeholder="EX: WELCOME10" value="{{ coupon ? coupon.code : '' }}">
                            <button class="btn btn-outline-dark btn-sm">Appliquer</button>
                        </form>
                        {% if coupon %}
                            <form method="post" action="{{ path('app_cart_coupon_remove') }}" class="mt-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_coupon_remove') }}">
                                <button class="btn btn-link p-0 text-muted">Retirer le code</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                <div class="mt-3 text-muted small">
                    Paiement securise et support client 7/7.
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
