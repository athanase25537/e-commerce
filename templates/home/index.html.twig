{% extends 'base.html.twig' %}

{% block title %}Accueil | E-commerce{% endblock %}

{% block body %}
<section class="hero-section">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-6">
                <span class="eyebrow text-uppercase">Nouvelle collection</span>
                <h1 class="display-5 fw-semibold mt-3">Des essentiels qui durent, un style qui reste.</h1>
                <p class="lead text-muted mt-3">
                    Decouvrez nos produits soigneusement selectionnes, avec une experience d'achat fluide et securisee.
                </p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a href="{{ path('app_shop_index') }}" class="btn btn-dark btn-lg">Explorer la boutique</a>
                    {% if not app.user %}
                        <a href="{{ path('app_register') }}" class="btn btn-outline-dark btn-lg">Creer un compte</a>
                    {% endif %}
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="hero-card p-4 p-lg-5">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h2 class="h5 mb-1">Promos de la semaine</h2>
                            <p class="text-muted small mb-0">Des offres pensees pour vous.</p>
                        </div>
                        <span class="badge bg-dark-subtle text-dark">-30%</span>
                    </div>
                    <div class="row g-3">
                        {% for product in featured_products|slice(0, 3) %}
                            <div class="col-12">
                                <div class="mini-product">
                                    <div class="mini-product__image">
                                        {% if product.image %}
                                            <img src="{{ product.image starts with 'http' ? product.image : asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}">
                                        {% else %}
                                            <div class="mini-product__placeholder">No image</div>
                                        {% endif %}
                                    </div>
                                    <div class="mini-product__content">
                                        <h3 class="h6 mb-1">{{ product.name }}</h3>
                                        <p class="text-muted small mb-0">{{ product.price }} </p>
                                    </div>
                                    <a href="{{ path('app_shop_show', {id: product.id}) }}" class="btn btn-sm btn-outline-dark">Voir</a>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <div class="alert alert-light mb-0">Aucun produit disponible pour le moment.</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
            <div>
                <h2 class="h4 mb-1">Parcourir par categorie</h2>
                <p class="text-muted mb-0">Trouvez rapidement ce qui vous correspond.</p>
            </div>
            <a href="{{ path('app_shop_index') }}" class="btn btn-outline-dark btn-sm">Voir tout</a>
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% for category in categories %}
                <a class="category-pill" href="{{ path('app_shop_index', {category: category.id}) }}">
                    {{ category.name }}
                </a>
            {% else %}
                <span class="text-muted">Aucune categorie disponible.</span>
            {% endfor %}
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
            <div>
                <h2 class="h4 mb-1">Produits en vedette</h2>
                <p class="text-muted mb-0">Notre selection du moment.</p>
            </div>
        </div>
        <div class="row g-4">
            {% for product in featured_products %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="product-card h-100">
                        <div class="product-card__media">
                            {% if product.image %}
                                <img src="{{ product.image starts with 'http' ? product.image : asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}">
                            {% else %}
                                <div class="product-card__placeholder">Image indisponible</div>
                            {% endif %}
                        </div>
                        <div class="product-card__body">
                            <h3 class="h6">{{ product.name }}</h3>
                            <p class="text-muted small mb-2">{{ product.description|slice(0, 80) }}{% if product.description|length > 80 %}...{% endif %}</p>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="price-tag">{{ product.price }}</span>
                                <a href="{{ path('app_shop_show', {id: product.id}) }}" class="btn btn-sm btn-dark">Decouvrir</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-light">Aucun produit disponible.</div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
