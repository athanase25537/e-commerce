{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h4 mb-2">Hello {{ controller_name }}!</h1>
                    <p class="text-muted mb-4">
                        This page uses Bootstrap styling for your templates.
                    </p>
                    <div class="list-group">
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('app_register') }}">
                            Creer un compte
                            <span class="badge bg-primary rounded-pill">Nouveau</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('app_login') }}">
                            Se connecter
                            <span class="badge bg-secondary rounded-pill">Retour</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
