{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Produits</h1>
            <span class="text-muted small">{{ products|length }} produit(s)</span>
        </div>
        <a href="{{ path('app_product_new') }}" class="btn btn-primary">Ajouter un produit</a>
    </div>

    {% if products is empty %}
        <div class="alert alert-info mb-0">Aucun produit pour le moment.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="text-muted">#</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Description</th>
                        <th scope="col">Image</th>
                        <th scope="col">Prix</th>
                        <th scope="col">Sous-categories</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td class="text-muted">{{ product.id }}</td>
                            <td class="fw-semibold">{{ product.name }}</td>
                            <td class="text-muted small">{{ product.description }}</td>
                            <td>
                                {% if product.image %}
                                    <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" class="rounded border"
                                         style="width: 48px; height: 48px; object-fit: cover;">
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>{{ product.price }}</td>
                            <td>
                                {% if product.subCategories is empty %}
                                    <span class="text-muted">-</span>
                                {% else %}
                                    {% for subCategory in product.subCategories %}
                                        <span class="badge text-bg-light me-1">{{ subCategory.name }}</span>
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_product_show', {id: product.id}) }}"
                                   class="btn btn-sm btn-outline-secondary me-2"
                                   title="Voir"
                                   aria-label="Voir">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8z"/>
                                        <path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                                    </svg>
                                </a>
                                <a href="{{ path('app_product_edit', {id: product.id}) }}"
                                   class="btn btn-sm btn-outline-secondary me-2"
                                   title="Mettre a jour"
                                   aria-label="Mettre a jour">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706l-1 1a.5.5 0 0 1-.708 0L13 3.207l1-1a.5.5 0 0 1 .707 0l.795.793z"/>
                                        <path d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/>
                                        <path d="M11.5 2.5l-7 7V11h1.5l7-7-1.5-1.5z"/>
                                    </svg>
                                </a>
                                {{ include('product/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
