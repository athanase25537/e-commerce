{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h1 class="h4 mb-0">Details du produit</h1>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-bg-light">Gestion</span>
                            <a href="{{ path('app_product_index') }}" class="btn btn-sm btn-outline-secondary">Retour</a>
                        </div>
                    </div>

                    <table class="table mb-4">
                        <tbody>
                            <tr>
                                <th scope="row" class="text-muted">ID</th>
                                <td>{{ product.id }}</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Nom</th>
                                <td>{{ product.name }}</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Description</th>
                                <td>{{ product.description }}</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Image</th>
                                <td>
                                    {% if product.image %}
                                        <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" class="rounded border"
                                             style="max-width: 220px; height: auto;">
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Prix</th>
                                <td>{{ product.price }}</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Sous-categories</th>
                                <td>
                                    {% if product.subCategories is empty %}
                                        <span class="text-muted">-</span>
                                    {% else %}
                                        {% for subCategory in product.subCategories %}
                                            <span class="badge text-bg-light me-1">{{ subCategory.name }}</span>
                                        {% endfor %}
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex flex-wrap gap-2">
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-outline-secondary">
                            Mettre a jour
                        </a>
                        {{ include('product/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
