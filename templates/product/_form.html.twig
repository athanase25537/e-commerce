{{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
    <div class="col-12">
        {{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-12">
        {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
    </div>
    <div class="col-12">
        {{ form_row(form.image, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.price, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.stock, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="col-12">
        {{ form_row(form.subCategories, {'attr': {'class': 'form-select'}}) }}
    </div>
    <div class="col-12 d-flex justify-content-end">
        <button class="btn btn-primary px-4">{{ button_label|default('Enregistrer') }}</button>
    </div>
{{ form_end(form) }}
